{
	"layer": "top",
	"position": "bottom",
	"height": 35,
	"margin-bottom": -3,
	"margin-top": 0,
	"margin-left": 8,
	"margin-right": 8,

	"modules-left": ["mango/workspaces","mango/window"],
	"modules-center": ["mpris"],
	"modules-right":  ["tray","pulseaudio","backlight","battery","clock"],

	"battery": {
		"states": {
		"warning": 30,
		"critical": 15
		},
	"format": "{icon}&#8239;{capacity}%",
	"format-charging": "󰂄&#8239;{capacity}%",
	"format-plugged": "󰂄&#8239;{capacity}%",
	"format-alt": "{icon} {time}",
	"format-icons": ["󰁺", "󰁻", "󰁽", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂"]
	},
	"ext/workspaces": {
		"sort-by-id": true,
		"on-click": "activate"
	},
	"dwl/window": {
		"max-length": 200
	},
	"tray": {
		"icon-size": 16,
		"spacing": 6
	},
	"clock": {
		"locale": "C", 
		"format": " {:%I:%M %p}",
		"format-alt": " {:%a, %b %d}" // Icon: calendar-alt
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
		"activated": "",
		"deactivated": ""
		}
	},
	"backlight": {
		// "device": "apple-panel-bl",
		"format": "{icon}&#8239;{percent}%",
		"format-icons": ["", ""],
		"on-scroll-down": "brightnessctl -c backlight set 5%-",
		"on-scroll-up": "brightnessctl -c backlight set +5%"
	},
	"pulseaudio": {
		// "scroll-step": 1, // %, can be a float
		"format": "{icon} {volume}%",
		"format-bluetooth": "{icon} {volume}% {format_source}",
		"format-bluetooth-muted": " {format_source}",
		"format-muted": "  {format_source}",
		"format-source": " {volume}%",
		"format-source-muted": "",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "🎧",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["", "", ""]
		},
  		"on-click": "pavucontrol-qt"
	},
	"mpris": {
		"format": "{player_icon} {artist} - {title}",
		"format-paused": "{player_icon} {artist} - {title}",
		"player-icons": {
		"default": "▶",
		"mpv": "🎵"
		},
		"status-icons": {
			"paused": "⏸"
		}
	},
	"cava": {
		"cava_config": "$HOME/.config/cava/config_waybar",
		"input_delay": 0,
		"format-icons" : [ "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
		"actions": {
			"on-click-right": "mode"
		}
	},
	"mango/workspaces": {
		"format": "{icon}",
		"hide-empty": true,
		"on-click": "activate",
		"on-click-right": "toggle",
		"overview-label": "OVERVIEW"
	},
	"mango/layout": {
		"format": "{}"
	},
	"mango/window": {
		"format": "{}",
		"icon-size": 20
	}
}
